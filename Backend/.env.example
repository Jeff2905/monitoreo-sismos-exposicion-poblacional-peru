PORT=4000
# IGP - ArcGIS REST, MapServer capa 0 "Sismos Reportados"
IGP_SISMOS_URL=https://ide.igp.gob.pe/arcgis/rest/services/monitoreocensis/SismosReportados/MapServer/0/query
# INEI - DKAN Datastore API (datosabiertos.gob.pe). Completar con un resource_id que tenga datastore activo
INEI_DATASTORE_URL=https://www.datosabiertos.gob.pe/api/action/datastore/search.json
INEI_RESOURCE_ID=
# Nombres de columnas del recurso INEI (ajustar tras revisar el diccionario de datos)
INEI_FIELD_DEPARTAMENTO=departamento
INEI_FIELD_POBLACION=poblacion
# Plan B si el recurso no esta en datastore: JSON local [{"departamento":"LIMA","poblacion":123}]
INEI_SNAPSHOT_PATH=data/poblacion_departamental.json
HTTP_TIMEOUT_MS=8000
CACHE_TTL_SECONDS=300
